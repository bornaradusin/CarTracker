<?xml version="1.0" encoding="utf-8"?>
<!-- A Traccar server at home may be plain http. The app itself only allows http:// for addresses
     on the home network (see ServerAddress.kt); anything else must be https://. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
