@@ -44,6 +44,27 @@ public class Jt808ProtocolEncoder extends BaseProtocolEncoder {
         super(protocol);
     }
 
+    /**
+     * The command as text when it's an SMS style command ending in '#', given as text or as its hex;
+     * null for anything else, such as a complete JT808 message in hex.
+     */
+    static byte[] smsCommand(String data) {
+        if (data == null || data.isEmpty()) {
+            return null;
+        }
+        byte[] bytes = data.matches("(?:[0-9a-fA-F]{2})+")
+                ? DataConverter.parseHex(data) : data.getBytes(StandardCharsets.US_ASCII);
+        if (bytes.length < 2 || bytes[bytes.length - 1] != '#') {
+            return null;
+        }
+        for (byte b : bytes) {
+            if (b < 0x20 || b > 0x7D) {
+                return null;
+            }
+        }
+        return bytes;
+    }
+
